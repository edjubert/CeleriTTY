{
  "name": "celeritty",
  "version": "1.3.2",
  "packageManager": "pnpm@10.30.1",
  "description": "Terminal emulator for the web. ANSI parsing in Rust (alacritty_terminal) compiled to WebAssembly, rendered with WebGPU.",
  "keywords": [
    "terminal",
    "terminal-emulator",
    "xterm",
    "alacritty",
    "webgpu",
    "wasm",
    "pty",
    "custom-element"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edjubert/celeritty.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "PROTOCOL.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element.js"
    },
    "./transport/websocket": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport-websocket.js"
    }
  },
  "scripts": {
    "build:wasm": "wasm-pack build crates/terminal-core --target web --out-dir ../../src/wasm --out-name celeritty",
    "build": "pnpm build:wasm && vite build && tsc -p tsconfig.build.json",
    "test": "pnpm test:rust && pnpm test:ts",
    "test:rust": "cargo test --workspace",
    "test:ts": "vitest run",
    "lint": "oxlint src/ harness/ debug/",
    "lint:fix": "oxlint --fix src/ harness/ debug/",
    "format": "oxfmt src/ harness/ debug/",
    "format:check": "oxfmt --check src/ harness/ debug/",
    "ts-check": "tsc --noEmit",
    "knip": "knip",
    "harness": "pnpm build:wasm && vite --config vite.harness.config.ts",
    "debug": "pnpm build:wasm && vite --config vite.debug.config.ts",
    "test:debug": "pnpm build:wasm && playwright test --config playwright.debug.config.ts",
    "test:browser": "pnpm build && playwright test",
    "test:neovim": "pnpm build && playwright test --config playwright.neovim.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.13.5",
    "@types/ws": "^8.18.1",
    "@webgpu/types": "^0.1.71",
    "happy-dom": "^20.11.2",
    "knip": "^6.22.0",
    "node-pty": "^1.1.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^5.7.0",
    "vite": "6.4.3",
    "vitest": "4.1.9",
    "ws": "^8.21.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  },
  "engines": {
    "node": ">=22.18.0 <25.0.0"
  }
}
