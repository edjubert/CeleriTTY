/target
/dist

# Anchored at every level, not just the root: examples/ have their own.
node_modules/

# Local-only override that points the example at this repository instead of
# the registry, so it runs before the package is published. Committing it
# would break the example for anyone who copies the directory.
examples/*/pnpm-workspace.yaml
examples/*/pnpm-lock.yaml

# wasm-pack output, regenerated by `pnpm build:wasm`. Imported by src/index.ts
# but never committed — see the package.json build script.
/src/wasm

# Browser regression artifacts.
/test-results
/playwright-report
