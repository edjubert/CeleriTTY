{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/element/index.ts",
    "src/transport/index.ts",
    "harness/main.ts",
    "vite.config.ts",
    "vite.harness.config.ts",
    "vite.debug.config.ts",
    "vitest.config.ts",
    "harness/browser/main.ts",
    "playwright.config.ts",
    "playwright.neovim.config.ts",
    "playwright.debug.config.ts",
    "debug/main.ts"
  ],
  "project": ["src/**/*.ts", "harness/**/*.ts", "debug/**/*.ts"],
  "ignore": ["src/wasm/**"],
  "ignoreBinaries": ["wasm-pack", "nvim"],
  "ignoreDependencies": ["@webgpu/types"]
}
